# Qwen3.8-Flash-Next NVFP4 on 4x RTX 4090 48GB
# Copy to .env and edit paths / ports / API key. .env is git-ignored.

# ---- model ----------------------------------------------------------------
# The recipe expects the published NVFP4 layout (48 layers, 512 experts,
# moe_intermediate_size=640, 1 MTP layer). Obtain it from its publisher.
MODEL_DIR="$HOME/models/Qwen3.8-Flash-Next-NVFP4"
FP8HYBRID_DIR="$HOME/models/Qwen3.8-Flash-Next-NVFP4-fp8hybrid"
MODEL_PATH="$FP8HYBRID_DIR"

# ---- build ----------------------------------------------------------------
VENV="$HOME/vllm-venv"
VLLM_VERSION="0.30.0"
VLLM_SRC="$HOME/src/vllm-0.30.0"
FA_SRC="$HOME/src/vllm-flash-attn"
# Optional: reuse an already-built +cu128 wheel and skip the source build.
VLLM_WHEEL=""
CUDA_HOME="/usr/local/cuda-12.8"
TORCH_CUDA_ARCH_LIST="8.9"

# ---- runtime --------------------------------------------------------------
GPU_IDS="0,1,2,3"
TP_SIZE=4

# ---- server ---------------------------------------------------------------
# Safe default: loopback only. For LAN access set BIND_HOST=0.0.0.0 AND an
# API key (or explicitly ALLOW_INSECURE=1 on a trusted network).
BIND_HOST="127.0.0.1"
PORT=12345
SERVED_MODEL_NAME="qwen38-flash-next-nvfp4"
API_KEY_FILE=""
ALLOW_INSECURE=0

# ---- tuning ---------------------------------------------------------------
MTP_K=2
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=32
GPU_MEM_UTIL=0.95
YARN_FACTOR=2.0
KV_CACHE_DTYPE="fp8_e4m3"
MAX_NUM_BATCHED_TOKENS=""   # empty = vLLM default (2048 with MTP_K=2)

# ---- paths ----------------------------------------------------------------
LOG_DIR="$HOME/.local/state/qwen38-flash-next"
